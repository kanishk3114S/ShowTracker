{
  "name": "showtracker-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:verify": "node src/db/verify-phase1.js",
    "test": "node test/api.test.js && node --test --test-concurrency=1 \"test/unit/**/*.test.js\" test/library.test.js test/stats-privacy.test.js test/library-groups.test.js test/franchise-sync.test.js test/release-radar.test.js test/provider-fallback.test.js test/provider-identities.test.js",
    "test:smoke": "node test/production-smoke.mjs",
    "test:live": "node test/live-smoke.mjs",
    "test:db": "node test/db-catalog.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.3.2"
  }
}
