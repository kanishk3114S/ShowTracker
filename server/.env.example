NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Runtime connection for Express API (restricted showtracker_app role with NOBYPASSRLS)
DATABASE_URL=postgresql://showtracker_app.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Migration connection for administrative DDL & schema migrations (admin postgres user)
MIGRATION_DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# TMDB API v3 "API Read Access Token" (Bearer). Backend only: never put this in a VITE_ variable.
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_READ_ACCESS_TOKEN=replace_me
