# ShowTracker backend (Express). Copy to server/.env (local) or set these in your host's
# environment screen (Render / Railway). NEVER commit the real file.

NODE_ENV=development
PORT=5000

# Browser origin(s) allowed to call this API (CORS). Comma-separate several.
#   local:       http://localhost:5173
#   production:  https://<your-frontend>.vercel.app
CLIENT_URL=http://localhost:5173

# Number of reverse-proxy hops in front of the API, so rate limiting sees the real visitor IP.
# Render / Railway / Heroku: 1 (the default when NODE_ENV=production). Local: leave unset.
# TRUST_PROXY=1

# Supabase project (Dashboard > Project Settings > API). Publishable key only; the server verifies
# user tokens with it and never needs the service_role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Runtime connection used by Express: the RESTRICTED showtracker_app role (NOBYPASSRLS).
# Use the Session Pooler URI; the username carries the project ref: showtracker_app.<project-ref>
DATABASE_URL=postgresql://showtracker_app.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Admin connection used ONLY by `npm run db:migrate` (DDL, storage bucket). Not needed at runtime;
# you may leave it out of the production environment and run migrations from your own machine.
MIGRATION_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# TMDB API v3 "API Read Access Token" (Bearer). Backend only: never put this in a VITE_ variable.
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_READ_ACCESS_TOKEN=replace_me

# TheTVDB API v4 key (optional second fallback for TV and movies, after TMDB and TVMaze).
# TVMaze needs no key. Without this key the app simply skips TheTVDB.
# Get one at https://thetvdb.com/api-information
TVDB_API_KEY=
